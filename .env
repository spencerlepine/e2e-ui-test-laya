# Committed on purpose: local values only (local Laya, local Ollama, no keys). Never put real keys here.
# Put a personal key in your shell environment instead; shell variables override this file.

# Decisions: local Laya on Apple Silicon (default, free, offline) or the hosted TypeSafe Jev policy.
DECISION_MODEL=laya
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx
# DECISION_MODEL=typesafe
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Text model: one call per task turns the goal into field values and a finish condition,
# plus TYPE_TEXT values in the TypeSafe mode. Any OpenAI-compatible endpoint; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=gemma4:latest
TEXT_MODEL_REASONING=none
# Fully offline instead (no key needed for localhost), e.g. Ollama:
# TEXT_MODEL_BASE_URL=http://localhost:11434/v1
# TEXT_MODEL=gemma4:latest

# Applies to every browser. Chrome and Edge: false opens the agent's tab in front, true keeps it in the background.
# Firefox: false shows its window, true runs it headless.
HEADLESS_MODE=false

# Browsers each test runs in. With several true, they run one after another (never in parallel), each as its own
# process with its own run folder.
# Firefox runs launch the installed Firefox (/Applications/Firefox.app) with a throwaway profile each time.
# Edge runs drive a dedicated test Edge (scripts/test_edge.sh, port 9334), started automatically when needed.
CHROME_ENABLED=true
FIREFOX_ENABLED=true
EDGE_ENABLED=false

# Every test run writes output/<time>-<browser>-test-<id>/ with prompt.txt and log.txt. true also records the agent's
# tab to capture.mov (needs ffmpeg: brew install ffmpeg); false skips only the video.
RECORD_VIDEO=true

# Browser: a dedicated test Chrome (start it with scripts/test_chrome.sh). It never asks for
# microphone, camera or notification permission: microphone and camera are fake devices, other prompts are denied.
# Delete these two lines to drive your everyday Chrome instead (it must have remote debugging enabled).
BU_CDP_URL=http://127.0.0.1:9333
BU_NAME=laya-test
# Hide the Hugging Face download progress bar when the local Laya checkpoint loads.
HF_HUB_DISABLE_PROGRESS_BARS=1

# Logins a goal may reference as {{NAME}} (examples/multi_tab.py). Only names listed in LAYA_CREDENTIALS can be typed;
# the value is read here just before input and never reaches the text model, logs or traces. A *_PASSWORD value is
# typed only into a password field. WARNING: .env is committed; these are the Amazon Connect test agent's login.
LAYA_CREDENTIALS=CCP_AGENTCHATUI_USERNAME,CCP_AGENTCHATUI_PASSWORD
CCP_AGENTCHATUI_USERNAME="Spenlep-prod-1"
CCP_AGENTCHATUI_PASSWORD="Spenlep-prod-1"
